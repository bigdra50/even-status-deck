{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "index.html",
    "server/providers/*.ts",
    "src/visibility/index.ts",
    "src/imu/index.ts",
    "src/battery/index.ts",
    "e2e/**/*.spec.ts",
    "**/*.test.ts"
  ],
  "project": ["src/**/*.ts", "server/**/*.ts", "e2e/**/*.ts", "scripts/**/*.mjs"],
  "ignoreBinaries": ["ipconfig"],
  "ignoreExportsUsedInFile": true,
  "tags": ["-public"]
}
