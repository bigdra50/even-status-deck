{
  "name": "eveng2-toolbar",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "sim": "evenhub-simulator http://localhost:5173",
    "pack": "npm run build && evenhub pack app.json dist -o eveng2-toolbar.ehpk",
    "upload": "node scripts/upload.mjs",
    "qr": "evenhub qr --url \"http://$(ipconfig getifaddr en0):5173\"",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.10",
    "@evenrealities/pretext": "^0.1.4",
    "lucide-static": "^1.16.0",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@evenrealities/evenhub-cli": "^0.1.11",
    "@evenrealities/evenhub-simulator": "^0.7.3",
    "@playwright/test": "1.60.0",
    "@types/sortablejs": "^1.15.9",
    "playwright": "^1.60.0",
    "smol-toml": "^1.6.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.4"
  }
}
